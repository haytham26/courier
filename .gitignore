# The load test's minted identity (a throwaway key, never a credential)
.loadtest/
# Maestro writes the evidence and the screenshots under the repo on every
# E2E run (run-all.sh), and the APK lands there too (android-e2e.yml): none
# of it is source.
.maestro/evidence/
/apk/
# The audits job exports the API's dependencies to a requirements file at the
# root (quality-gates.yml) so pip-audit can read it: generated, never source.
/requirements.txt

# The squad worktrees live inside the repo for tooling convenience; they are
# working copies, never source (an accidental gitlink was committed once).
/.worktrees/
# Scratch helper scripts (GitHub-listing, merges): never source, and they must
not reach gitleaks' view of the repo.
/.opencode-tmp/
graphify-out/
.deploy-state
