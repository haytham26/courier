# The supply-chain settings for pnpm live in pnpm-workspace.yaml (pnpm 12 reads
# them from there). This file only carries the installer behaviour.
# nosemgrep: the pnpm 10 settings the community rules expect no longer apply (W3)
auto-install-peers=true
shamefully-hoist=true
ignore-scripts=true
pnpm.ignored-build-scripts=esbuild
# Supply-chain policy (V4 §7): a package must be at least seven days old before
# it may enter the lockfile, and a published version may not downgrade the
# policy of a version already in the tree.
minimum-release-age=10080
trust-policy=no-downgrade
