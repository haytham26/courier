# The edge of the founder's local stack (the 2026-11-12 directive item 1).
#
# It is the staging edge (infra/Caddyfile.staging) with ONE difference, and the
# difference is the TLS layer only:
#
#   * the site address is `http://` instead of a bare hostname.
#
# A bare-hostname site makes Caddy answer HTTP on 80 with a 308 redirect to the
# same host on 443 (its automatic HTTPS), because a host with a TLS site is
# assumed to want HTTPS. Behind a Cloudflare quick tunnel that is a loop: the
# tunnel terminates TLS for its own hostname, forwards plain HTTP to this edge,
# and this edge would send the phone back to the same TLS hostname that is this
# tunnel. The app's HTTPS is the tunnel's, and it is a real one (a valid
# *.trycloudflare.com certificate) - so the edge here serves the site over HTTP
# and does not redirect.
#
# EVERYTHING ELSE IS THE STAGING BEHAVIOUR, unchanged, because a difference
# between this edge and staging's that the founder never exercises is a
# difference that ships untested: the same security headers, the same rate
# limits, the same 404 for /health*, the same retrying load balance over the
# replicas, the same upstream health URIs (BUG-095's /healthz correction and
# AUTH's /health/ready).

{
	# Kept from the staging file: with no TLS site in this file Caddy issues no
	# certificate of its own, and the local CA is inert here rather than
	# wrong.
	pki {
		ca local
	}

	email {$ACME_EMAIL}

	# The admin API stays on the loopback interface: nothing outside the
	# container can reload the configuration.
	admin localhost:2019
}

http://{$COURIER_DOMAIN} {
	encode zstd gzip

	# The same access log the heartbeat counts (infra/monitoring/heartbeat.sh),
	# so a local deployment is observed the same way production is.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}

	# The security headers on every answer: the production set, unchanged.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "geolocation=(self), camera=(), microphone=(self), payment=()"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
		-Server
	}

	rate_limit {
		zone general {
			key {remote_host}
			events 120
			window 1m
			ipv6_prefix 64
		}
	}

	# The health endpoints are for the edge and for the heartbeat, not for the
	# public: the edge answers 404 so the version never leaks.
	handle /health* {
		respond 404
	}

	handle /api/auth/* {
		rate_limit {
			zone auth {
				key {remote_host}
				events 20
				window 1m
				ipv6_prefix 64
			}
		}
		reverse_proxy auth_a:3001 {
			lb_try_duration 5s
			lb_try_interval 250ms
			health_uri /health/ready
			health_interval 10s
			health_timeout 3s
		}
	}

	handle {
		reverse_proxy api_a:8000 {
			lb_try_duration 5s
			lb_try_interval 250ms
			# The API's own route is /healthz (its contract carries it, and its
			# compose healthcheck was corrected to it in A5's first slice) - but
			# Caddy's upstream check still asked for /health/ready, which the API
			# does not serve. The 404 that comes back marks the upstream unhealthy
			# and the edge answers 503 for every request, which reads like a dead
			# API and is really a dead health check. The auth service below
			# answers /health/ready for real (services/auth/src/health.ts), so it
			# keeps that path.
			health_uri /healthz
			health_interval 10s
			health_timeout 3s
		}
	}
}
