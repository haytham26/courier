# The environment of the Courier Copilot production stack.
#
# Copy this file to infra/prod.env, fill it in and keep it out of the
# repository: `infra/prod.env` is gitignored. The file is read by Docker
# Compose (--env-file) and by the scripts in this folder.
#
#   cp infra/env.example infra/prod.env
#   chmod 600 infra/prod.env
#   docker compose --env-file infra/prod.env -f infra/compose.prod.yml up -d
#
# Nothing in this file is a real value. Every secret is generated on the
# server and never leaves it.

# ---- The public name of the deployment -------------------------------------
# Why: the edge (Caddy) gets the certificate for it, the auth service builds
# its public URL from it and the API refuses tokens from another issuer.
# Where: the founder registers the name and points the DNS at the server.
COURIER_DOMAIN=replace-with-the-public-name

# Why: Caddy sends the certificate notices (the expiry, a renewal failure)
# to this address. Where: the founder's mailbox.
ACME_EMAIL=replace-with-the-mailbox

# ---- The version being deployed ---------------------------------------------
# Why: the health endpoints report it, so the operator can see at once which
# version answers. Where: the release tag (v1.2.3), set by the deploy step.
APP_VERSION=0.0.0-dev

# ---- The database -----------------------------------------------------------
# Why: the database of the couriers, the shifts and the door memory.
# Where: generated on the server: openssl rand -base64 32
POSTGRES_USER=courier
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=courier

# Why: the cache and the store of the rate limiter. Never exposed.
# Where: generated on the server: openssl rand -base64 32
VALKEY_PASSWORD=replace-with-a-generated-password

# ---- The auth service -------------------------------------------------------
# Why: the secret the auth service signs the session and the token cookies
# with. Changing it signs every courier out. At least 32 characters.
# Where: generated on the server: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-generated-secret

# Why: the origins the auth service accepts a request from. The web dashboard
# and the mobile app (exp://) are listed there. Required in production.
# Where: the founder decides the domains of the app.
AUTH_TRUSTED_ORIGINS=exp://,https://replace-with-the-app-name

# Why: the path the JWKS is served on. Better Auth publishes it under its
# base path (/api/auth), so the default gives /api/auth/jwks. The API reads
# the same path, so the two must not drift apart.
# Where: the default of the auth service; change it in both places.
AUTH_JWKS_PATH=/jwks

# Why: the hosts the API (and the voice service) may fetch the JWKS from over
# PLAINTEXT http. https is always allowed and loopback is exempt; every other
# plaintext host must be named here or the service refuses to boot (BUG-131:
# a plaintext hop a network-adjacent attacker can read lets them substitute a
# key pair). The compose network's auth service is named in compose.prod.yml
# and compose.staging.yml; add a host only on purpose.
# Where: the internal host names, comma separated; empty by default.
AUTH_JWKS_INTERNAL_HOSTS=auth

# Why: the sha256 fingerprints the JWKS's keys are allowed to carry, computed
# over the key's canonical form (sorted JSON). When set, a document that
# serves any other key is refused per refresh, so a substituted key pair is
# caught even on an allowed hop (BUG-131's second half). Compute one with:
#   python -c "import hashlib,json;k=json.load(open('jwk.json'));print(hashlib.sha256(json.dumps(k,sort_keys=True,separators=(',',':')).encode()).hexdigest())"
# Where: operator set; empty (unpinned) by default.
AUTH_JWKS_KEY_FINGERPRINTS=

# Why: the audience the API checks on the access token. The default is the
# one the API and the auth service share.
# Where: the default; change it in both places.
AUTH_JWT_AUDIENCE=courier-api

# Why: the issuer the API checks on the access token. The default is the
# public URL of the auth service, the same one the auth service signs with.
# Where: the public URL (https://$COURIER_DOMAIN).
AUTH_JWT_ISSUER=https://replace-with-the-public-name

# Why: how long an access token lives. The app refreshes it silently.
# Where: the default (15 minutes).
AUTH_JWT_EXPIRATION=15m

# Why: the requests a minute a single address may make to the auth service
# that is not a credential endpoint. The credential endpoints have their own,
# tighter limits inside the service.
# Where: the default.
AUTH_RATE_LIMIT_MAX=100

# ---- The images -------------------------------------------------------------
# Why: the compose file needs to know which image to run. The release tags
# the images; a digest (name@sha256:...) pins the exact build.
# Where: the registry the release workflow pushes to, or the local build.
COURIER_API_IMAGE=courier-api:local
COURIER_AUTH_IMAGE=courier-auth:local
COURIER_CADDY_IMAGE=courier-caddy:2.10.2
COURIER_POSTGRES_IMAGE=courier-postgres:16-3.6-pgvector
COURIER_HEARTBEAT_IMAGE=courier-heartbeat:local

# ---- The network ------------------------------------------------------------
# Why: the name of the network the stack and the monitoring share, and the
# addresses the services keep. The addresses must not change: the edge keeps
# its name resolution, and that is what makes the swap without downtime work.
# Where: the defaults; change them only when the server network clashes.
# COURIER_IPV4_PREFIX is the first three parts of the addresses: change it
# together with the subnet, never on its own.
COURIER_NETWORK=courier-net
COURIER_SUBNET=172.28.0.0/24
COURIER_IPV4_PREFIX=172.28.0

# ---- The backups ------------------------------------------------------------
# Why: the folder the dumps land in. The heartbeat reads it to see whether
# the backups are still fresh. Where: a folder on the server, owned by root.
BACKUP_DIR=/var/backups/courier

# The database the backup and the restore scripts talk to. The same
# variables the PostgreSQL client uses.
# Why: the scripts refuse to run without them.
# Where: the values of the database above.
PGHOST=localhost
PGPORT=5432
PGUSER=courier
PGPASSWORD=replace-with-a-generated-password
PGDATABASE=courier

# Why: when it is set, the scripts run the database client inside this
# compose service instead of on the machine. Leave it empty when the host
# has the PostgreSQL client installed.
# Where: the name of the service in infra/compose.prod.yml.
COURIER_DB_CONTAINER=postgres

# Why: the compose file the scripts drive. Where: this folder.
COMPOSE_FILE=infra/compose.prod.yml

# Why: the environment file of the compose file above. The scripts need it
# when they run the database client inside a container, because the compose
# file reads the secrets from it.
# Where: the file the deploy uses (infra/prod.env on the server).
COURIER_COMPOSE_ENV_FILE=infra/prod.env

# Why: the name of the production database. The restore refuses to touch it
# without the approval of the founder.
# Where: the value of POSTGRES_DB above.
PRODUCTION_DB=courier

# ---- The monitoring ---------------------------------------------------------
# Why: the webhook that receives the alerts. Any webhook that accepts a JSON
# body with a "text" field works (Slack, Discord, Mattermost, ntfy).
# Where: the founder creates it in the chat tool of the team.
ALERT_WEBHOOK_URL=

# Why: the seconds between two checks, and between two alerts of the same
# kind. Where: the defaults.
HEARTBEAT_INTERVAL=60
ALERT_COOLDOWN=900

# Why: how many checks in a row have to fail before the team is woken. Three
# minutes of failures is an incident, one slow answer is not.
# Where: the default.
FAILURES_BEFORE_ALERT=3

# Why: the share of the requests that may answer 5xx before the team is
# woken, and the smallest number of requests that is worth judging.
# Where: the defaults.
ERROR_RATE_LIMIT=5
ERROR_RATE_MINIMUM_REQUESTS=20

# Why: how old the newest backup may be, how many days before the
# certificate expiry the team is warned, and how full the disk may get.
# Where: the defaults. The rules are written down in
# infra/monitoring/ALERTS.md.
BACKUP_MAX_AGE_HOURS=26
CERTIFICATE_MINIMUM_DAYS=14
DISK_MAX_PERCENT=85
