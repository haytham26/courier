# The CI staging environment (A5's verify leg; the workflow's runner reads it).
#
# It is a throwaway deployment: the passwords are fixed, the data is disposable,
# and the only thing it proves is that the stack builds and serves. Every value
# the workflow needs but does not set here comes from the job's env; the values
# below are the ones that must always be present, because the compose file
# refuses to render without them (the `:?` form names each one).
#
# Never a real secret: the runner's stack is deleted with the job.

POSTGRES_USER=courier
POSTGRES_DB=courier
POSTGRES_PASSWORD=ci-staging-postgres
VALKEY_PASSWORD=ci-staging-valkey
BETTER_AUTH_SECRET=ci-staging-better-auth-secret-0123456789abcdef
AUTH_TRUSTED_ORIGINS=https://staging.courier.local,exp://
APP_VERSION=ci-verify
COURIER_DOMAIN=staging.courier.local
ACME_EMAIL=ci-verify@courier.local
