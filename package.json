{
  "name": "courier",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/web",
    "packages/*",
    "services/auth"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test && pnpm run test:api",
    "test:api": "uv run --directory apps/api pytest -q",
    "lint": "turbo run lint && pnpm run lint:api",
    "lint:api": "uv run --directory apps/api ruff check .",
    "typecheck": "turbo run typecheck && pnpm run typecheck:api",
    "typecheck:api": "uv run --directory apps/api mypy .",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "check:fast": "pnpm typecheck && pnpm lint && node scripts/check-floor.mjs",
    "check:task": "pnpm check:fast && pnpm test",
    "check:full": "pnpm check:task && pnpm coverage && node scripts/check-licenses.mjs",
    "coverage": "node scripts/run-coverage.mjs",
    "format:check": "prettier --check .",
    "check-secrets": "node scripts/check-secrets.js",
    "push-secrets": "bash scripts/push-secrets.sh",
    "open-secrets": "bash scripts/open-secrets.sh"
  },
  "devDependencies": {
    "turbo": "2.11.9",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "typescript-eslint": "8.71.0",
    "pnpm": "12.14.0"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "ignoredBuiltScripts": ["esbuild"]
  }
}