   // functions
+  // BUG-066: build the PropNameID directly instead of via PropNameIDCache -
+  // the cache's miss path re-enters JS (JSICache -> defineGlobal ->
+  // Object.defineProperty) while a borrowing reference is held, and the
+  // cold-start Hermes free then faults (runs 40274121944 and 40334465490;
+  // margelo/nitro#1150's confirmed working patch, first suggestion).
   inline jsi::Function toJSFunction(jsi::Runtime& runtime) const {
-    return jsi::Function::createFromHostFunction(runtime, PropNameIDCache::get(runtime, _name), static_cast<unsigned int>(_paramCount),
+    return jsi::Function::createFromHostFunction(runtime, jsi::PropNameID::forUtf8(runtime, _name), static_cast<unsigned int>(_paramCount),
                                                  _function);
   }
 
