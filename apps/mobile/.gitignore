# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
# expo-env.d.ts STAYS TRACKED since Expo CLI SDK 49: it is generated once by
# "npx expo customize" (the note inside says "should be committed") and the
# app tsconfig includes it for the ambient process.env typing; without it a
# fresh clone (CI) reads EXPO_PUBLIC_* as any and the lint gate fails there
# while it passes on machines that happen to have the file.

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# the offline map pack: build artefacts, not source
assets/maps/*.pmtiles
assets/maps/*.manifest.json
assets/maps/glyphs/

# generated native folders
/ios
/android
