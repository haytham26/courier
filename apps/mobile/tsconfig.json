{
  "compilerOptions": {
    "paths": {
      "@courier/design-tokens/*": ["../../packages/design-tokens/dist/*"],
      "@courier/shared/*": ["../../packages/shared/dist/*"],
      "@/*": ["./src/*"],
      "*": ["./*"]
    },
    "types": ["jest"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "__mocks__/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/__tests__/**"],
  "extends": "expo/tsconfig.base"
}