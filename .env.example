# Copy to .env.local (gitignored) and fill. NEVER commit real values.
# Internal secrets marked [GEN] are generated by the agent (openssl rand -base64 32).

# ---- Core / NOW (free) ----
APP_ENV=dev                      # dev | staging | prod
DATABASE_URL=                    # [GEN] local Docker Postgres in dev; Oracle self-hosted in prod (Neon optional dev alt)
BETTER_AUTH_SECRET=              # [GEN] 32+ random bytes
BETTER_AUTH_URL=                 # e.g. http://localhost:3000

# ---- Auth service (services/auth) + API token verification ----
AUTH_DATABASE_URL=               # postgres://... for services/auth (memory:// only outside production)
AUTH_TRUSTED_ORIGINS=            # csv; e.g. exp://,courier://,https://app.example.co.nz (required in production)
AUTH_TRUSTED_IP_HEADERS=         # only when behind a trusted proxy (e.g. x-forwarded-for); empty otherwise
AUTH_JWT_ISSUER=                 # defaults to BETTER_AUTH_URL
AUTH_JWT_AUDIENCE=courier-api    # audience the API checks
AUTH_JWT_EXPIRATION=15m          # access token lifetime
AUTH_JWKS_PATH=/jwks             # JWKS endpoint path on the auth service
AUTH_RATE_LIMIT_MAX=100          # requests/minute per IP for non-credential endpoints
AUTH_JWKS_URL=                   # e.g. http://localhost:3000/api/auth/jwks (API verifies tokens with it)
AUTH_JWT_ALGORITHMS=ES256        # algorithms the API accepts

# ---- Sign-in methods (MASTER_EXECUTION §14) ----
# Each provider is switched on only when its id is here. Without them the
# service starts without the provider and the app disables the button.
AUTH_GOOGLE_CLIENT_ID=           # Google Cloud -> OAuth client id (Android, iOS, web)
AUTH_GOOGLE_CLIENT_SECRET=       # Google Cloud -> client secret (the web flow; the native flow uses PKCE)
AUTH_APPLE_CLIENT_ID=            # Apple Developer -> Services ID (or the bundle id)
AUTH_APPLE_CLIENT_SECRET=        # Apple Developer -> the signed client secret (a JWT)
AUTH_APPLE_BUNDLE_ID=            # com.courier.copilot (the iOS audience)
AUTH_PASSKEY_RP_ID=              # the relying party domain, e.g. auth.example.co.nz
AUTH_PASSKEY_RP_NAME=Courier Copilot
AUTH_PASSKEY_ORIGIN=             # defaults to https://<AUTH_PASSKEY_RP_ID>
AUTH_MFA_ISSUER=Courier Copilot  # the name the authenticator app shows
AUTH_MFA_BACKUP_CODES=10         # backup codes per courier
AUTH_MFA_MAX_FAILED_ATTEMPTS=5   # wrong codes before the account is locked
AUTH_MFA_LOCKOUT_SECONDS=900     # how long the lock lasts

# LINZ
LINZ_LDS_API_KEY=                # data.linz.govt.nz -> profile -> API keys (NZ addresses)
LINZ_BASEMAPS_API_KEY=           # basemaps.linz.govt.nz -> developer key (map tiles)

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=            # scoped token (Workers AI + R2 + DNS as needed)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=                     # https://<account_id>.r2.cloudflarestorage.com

# Oracle Cloud (Always Free VM: API/Valhalla/LiveKit)
OCI_HOST=                        # public IP of the VM
OCI_SSH_PRIVATE_KEY_PATH=        # local path only; key itself stays outside repo

# LLM / AI (free tiers)
GROQ_API_KEY=
CEREBRAS_API_KEY=
CF_WORKERS_AI_TOKEN=             # may reuse CLOUDFLARE_API_TOKEN
GOOGLE_AI_STUDIO_API_KEY=        # DEV ONLY - never prod with real data
OPENROUTER_API_KEY=              # DEV ONLY

# Mobile build / CI
EXPO_TOKEN=                      # expo.dev -> account settings -> access tokens
GITHUB_TOKEN=                    # fine-grained PAT, only to set Actions secrets
ANDROID_KEYSTORE_BASE64=         # [GEN] -> stored in GitHub Secrets, not here
ANDROID_KEYSTORE_PASSWORD=       # [GEN]
ANDROID_KEY_ALIAS=               # [GEN]
ANDROID_KEY_PASSWORD=            # [GEN]

# Voice (self-hosted)
LIVEKIT_URL=
LIVEKIT_API_KEY=                 # [GEN]
LIVEKIT_API_SECRET=              # [GEN]

# Email / analytics / errors
RESEND_API_KEY=
EMAIL_FROM=
POSTHOG_API_KEY=                 # EU host
POSTHOG_HOST=https://eu.i.posthog.com
GLITCHTIP_DSN=

# Payments (test mode now)
STRIPE_SECRET_KEY=               # sk_test_...
STRIPE_PUBLISHABLE_KEY=          # pk_test_...
STRIPE_WEBHOOK_SECRET=           # whsec_... (stripe listen / dashboard webhook)

# ---- BEFORE LAUNCH (optional now) ----
APPLE_TEAM_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_KEY_P8_BASE64=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_BASE64=
FASTLANE_MATCH_PASSWORD=         # [GEN]
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=
REVENUECAT_WEBHOOK_SECRET=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SMS_PROVIDER=                    # [OPEN] e.g. twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=                 # NZ long number
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=

# ---- Added by final edit ----
DATA_ENCRYPTION_MASTER_KEY=      # [GEN] envelope-encryption master key (server only)
GEMINI_API_KEY=                  # LATER/paid: Gemini Live GA paid tier, optional fallback

# ---- POD storage (ADR-011) ----
# local = a directory on the API server (the default, single instance);
# s3    = any S3-compatible object store (AWS S3, Cloudflare R2, Wasabi).
# Real buckets and keys are FOUNDER_TODO items; MinIO is banned (AGPL-3.0).
POD_STORAGE_BACKEND=local
POD_STORAGE_DIR=
POD_URL_SIGNING_SECRET=        # [GEN] >=32 chars; required for the local backend
POD_S3_BUCKET=
POD_S3_ENDPOINT_URL=
POD_S3_REGION=
POD_S3_SERVER_SIDE_ENCRYPTION=  # e.g. AES256 (optional; a bucket policy can enforce it)
POD_S3_ACCESS_KEY_ID=
POD_S3_SECRET_ACCESS_KEY=
POD_URL_TTL_SECONDS=900

# ---- The intake through OmniRoute (D25; the self-hosted gateway) ----
# With both set, the intake's extraction/phrasing and the manifest OCR answer
# through the OpenAI-compatible gateway. Without them the API uses the
# deterministic fake: voice intake works (one parcel per spoken line), the
# manifest path answers 503 - it never invents a manifest from a photo.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=courier-intake
