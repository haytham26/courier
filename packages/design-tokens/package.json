{
  "name": "@courier/design-tokens",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "default": "./dist/themes.js"
    },
    "./contrast": {
      "types": "./dist/contrast.d.ts",
      "default": "./dist/contrast.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contrast:report": "vitest run src/contrast.test.ts -t \"contrast table\""
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@courier/eslint-config": "workspace:*",
    "typescript": "5.9.3",
    "@vitest/coverage-v8": "4.1.11",
    "vitest": "4.1.11",
    "eslint": "10.13.0",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0"
  }
}
